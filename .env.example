# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agentvault?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Auth
NEXTAUTH_SECRET=change-me-in-production
NEXTAUTH_URL=http://localhost:3000

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Benchmarking
BENCHMARK_CRON_SECRET=change-me-in-production

# Encryption (must be exactly 32 characters)
ENCRYPTION_KEY=change-me-in-production-32chars!

# Google OAuth (optional — Google sign-in disabled without this)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Stripe (optional — payment features disabled without these)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# STRIPE_BUILDER_PRICE_ID= (legacy — use STRIPE_FIELD_AGENT_PRICE_ID)
# STRIPE_SCALE_PRICE_ID= (legacy — use STRIPE_DOUBLE_0_PRICE_ID)
STRIPE_FIELD_AGENT_PRICE_ID=
STRIPE_DOUBLE_0_PRICE_ID=
STRIPE_SHADOW_PRICE_ID=
STRIPE_CONNECT_WEBHOOK_SECRET=

# --- added when the standalone Stripe service was merged in (see src/stripe/README.md) ---

# One-off provider listing deposit ($49). Without it POST /api/stripe/deposit 400s.
STRIPE_LISTING_DEPOSIT_PRICE_ID=

# Metered overage prices. Used ONLY to tell overage revenue apart from
# subscription revenue on a paid invoice. If these are unset, every invoice
# line counts as subscription revenue and the 50/50 overage split never applies.
STRIPE_OVERAGE_FIELD_AGENT_PRICE_ID=
STRIPE_OVERAGE_DOUBLE_0_PRICE_ID=
STRIPE_OVERAGE_SHADOW_PRICE_ID=

# Currency for provider transfers. Defaults to usd, which is what the live
# payout engine has always sent. Connected accounts are created with
# country=au and the standalone service sent aud — decide, then set this once.
STRIPE_PAYOUT_CURRENCY=usd

# A real User row id representing the platform itself. Only needed so the
# monthly payout run can write its "retained_native" reporting row; leave unset
# and that row is skipped (the run summary says so).
PLATFORM_USER_ID=

# The standalone service used these names. Still accepted as fallbacks so a
# half-migrated Railway env keeps working — delete once the STRIPE_* names above
# are set everywhere.
# PRICE_FIELD_AGENT=
# PRICE_DOUBLE_0=
# PRICE_SHADOW=
# PRICE_LISTING_DEPOSIT=

# Telegram bot
TELEGRAM_BOT_TOKEN=

# Anthropic (for AI-powered agent features)
ANTHROPIC_API_KEY=
